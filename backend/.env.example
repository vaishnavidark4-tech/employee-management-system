# Port the API runs on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/employee_task_db
MONGO_URI=mongodb://127.0.0.1:27017/employee_task_db

# Frontend URL(s) allowed by CORS. Use a comma to add more than one.
CLIENT_URL=http://localhost:5173

# Timezone used to decide "today" for the Overdue rule
TZ=Asia/Kolkata

NODE_ENV=development
