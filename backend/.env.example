# Port the API runs on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/employee_task_db
MONGO_URI=mongodb://127.0.0.1:27017/employee_task_db

# Frontend URL(s) allowed by CORS. Use a comma to add more than one.
CLIENT_URL=http://localhost:5173

# Secret key used to sign login tokens (JWT). Use a long random string, never commit the real one.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# How long a login stays valid (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Timezone used to decide "today" for the Overdue rule
TZ=Asia/Kolkata

NODE_ENV=development
